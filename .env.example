# Jarvis Environment Configuration

# LLM Provider (ollama, openai, anthropic, gemini)
DEFAULT_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Cloud LLM Keys (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Voice
ENABLE_VOICE=false
WAKE_WORD=jarvis
STT_MODEL=tiny
TTS_ENGINE=pyttsx3

# Features
ENABLE_BROWSER=false
ENABLE_CODE_EXEC=true
ENABLE_MCP=false
ENABLE_SCHEDULER=false

# API
ENABLE_API=false
API_HOST=127.0.0.1
API_PORT=7777
ENABLE_AUTH=false
API_KEY=

# Email (IMAP)
# EMAIL_ADDRESS=your.email@gmail.com
# EMAIL_APP_PASSWORD=your-app-password-here
# EMAIL_PROVIDER=gmail  # gmail, outlook, or yahoo

# Security
SANDBOX_MODE=false
